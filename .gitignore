# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.example is the exception: it names every key the app reads and carries no
# secret, so cloning and copying it is the fastest way to a running app.
.env*
!.env.example

# vercel
.vercel

# local agent settings (machine-specific paths, chat ids and other locals accumulate in
# cached permission entries). .claude/skills/ is vendored on purpose and stays tracked.
.claude/settings.json
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# rust / soroban build artifacts
contracts/target/
