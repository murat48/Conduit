# Copy to .env.local and fill in. Only NEXT_PUBLIC_ANCHOR_HOME_DOMAIN is required to run the
# full TRY ⇄ USDC flow; everything else enables an optional feature.
#
# Rule of thumb: a secret never gets a NEXT_PUBLIC_ prefix, or it ships in the client bundle.
# Every key below is read only inside an API route.

# ── Anchor (required) ────────────────────────────────────────────────────────
# SEP-1/6/10/12/38. No API key: the user's keypair is the identity, proved via SEP-10.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# The currency that anchor settles in, as SEP-38 names it. Changes together with the domain, and
# nothing else has to: no code path tests for lira, only for whether an asset is fiat.
NEXT_PUBLIC_ANCHOR_FIAT_ASSET=iso4217:TRY

# ── Stellar network (optional — sensible testnet defaults are built in) ──────
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Telegram notifications (optional) ────────────────────────────────────────
# /api/telegram proxies every message so the token never reaches the browser.
# Left empty, the proxy answers 400 and the UI reports it instead of failing silently.
TELEGRAM_BOT_TOKEN=

# ── Plain-language strategy assistant (optional) ─────────────────────────────
# AI_PROVIDER picks which one is actually called; switch without touching code.
# 'gemini' is free and fine for local development; 'anthropic' is what the deployed app uses.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Pin a model release, or leave empty for the built-in default
# (gemini-3.5-flash-lite / claude-sonnet-5).
GEMINI_MODEL=
ANTHROPIC_MODEL=

# ── Soroswap REST API (not used at runtime) ──────────────────────────────────
# Swaps and quotes go straight to the router contract over Soroban RPC, because the
# Routing API does not index testnet pools. These are only read by the legacy
# /api/quote, /api/build and /api/send proxy routes, which nothing currently calls.
SOROSWAP_API_HOST=
SOROSWAP_API_KEY=
